@using Rinsen.Outback.App.Models
@model DeviceConsentViewModel
@{
    Layout = "_LayoutIdentity";
}

@using (Html.BeginForm("Consent", "Device", FormMethod.Post, htmlAttributes: new { @class = "form-signin" }))
{
    <h1 class="h3 mb-3 font-weight-normal">Please authorize user code</h1>
    @Html.HiddenFor(m => m.UserCode)
    <div class="form-group">
        <label>Requested access</label>
        @if (Model.Scopes.Count == 0)
        {
            <p>No specific scopes were requested.</p>
        }
        else
        {
            <ul>
                @foreach (var scope in Model.Scopes)
                {
                    <li>
                        <strong>@scope.DisplayName</strong>
                        @if (!string.IsNullOrEmpty(scope.Description))
                        {
                            <span> — @scope.Description</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
    <button type="submit" name="Authorize" value="true" class="btn btn-lg btn-primary w-100">Authorize device</button>
    <button type="submit" name="Authorize" value="false" class="btn btn-lg btn-danger w-100">Reject</button>
    <p class="mt-5 mb-3 text-muted">&copy; 2019-@DateTime.Now.Year</p>
    @Html.AntiForgeryToken()
}
