@using Rinsen.Outback.App.Models
@model DeviceConsentViewModel
@{
    Layout = "_LayoutIdentity";
}

@using (Html.BeginForm("Index", "Device", FormMethod.Get, htmlAttributes: new { @class = "form-signin" }))
{
    <h1 class="h3 mb-3 font-weight-normal">Please enter the user code</h1>
    @Html.LabelFor(m => m.UserCode, "User code", htmlAttributes: new { @class = "sr-only" })
    @Html.TextBoxFor(m => m.UserCode, new { @type = "user_code", @class = "form-control", placeholder = "User code", @value = Model.UserCode })
    <button class="btn btn-lg btn-primary w-100" type="submit">Continue</button>
    <p class="mt-5 mb-3 text-muted">&copy; 2019-@DateTime.Now.Year</p>
}
